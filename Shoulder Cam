				onHold(false)
			end
		end))
	end

	makePadBtn("Fwd", "W", UDim2.fromOffset(56, 0), function(h) mobileMoveVec = Vector2.new(mobileMoveVec.X, h and 1 or 0) end)
	makePadBtn("Back", "S", UDim2.fromOffset(56, 80), function(h) mobileMoveVec = Vector2.new(mobileMoveVec.X, h and -1 or 0) end)
	makePadBtn("Left", "A", UDim2.fromOffset(4, 40), function(h) mobileMoveVec = Vector2.new(h and -1 or 0, mobileMoveVec.Y) end)
	makePadBtn("Right", "D", UDim2.fromOffset(108, 40), function(h) mobileMoveVec = Vector2.new(h and 1 or 0, mobileMoveVec.Y) end)
	makePadBtn("Up", "UP", UDim2.fromOffset(178, 18), function(h) mobileVerticalMove = h and 1 or 0 end)
	makePadBtn("Down", "DN", UDim2.fromOffset(178, 62), function(h) mobileVerticalMove = h and -1 or 0 end)
end

local function updateCamera(dt: number)
	if destroyed or not cameraEnabled then return end
	dt = math.min(dt, 0.05)

	local root = getRootPart()
	local humanoid = getHumanoid()

	camera.CameraType = Enum.CameraType.Scriptable

	if not UserInputService.TouchEnabled and not isDraggingGui and not activeSliderId then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	currentYaw += (yaw - currentYaw) * math.min(1, rotationLerpSpeed * dt)
	currentPitch += (pitch - currentPitch) * math.min(1, rotationLerpSpeed * dt)
	currentDistance += (targetDistance - currentDistance) * math.min(1, cameraLerpSpeed * dt)

	local rotCFrame = CFrame.fromOrientation(currentPitch, currentYaw, 0)
	local forward = rotCFrame.LookVector
	local right = rotCFrame.RightVector

	if isFreecam then
		local moveInput = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveInput += forward end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveInput -= forward end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveInput += right end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveInput -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveInput += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveInput -= Vector3.yAxis end

		if mobileMoveVec.Magnitude > 0.01 then
			moveInput += (forward * mobileMoveVec.Y) + (right * mobileMoveVec.X)
		end
		if math.abs(mobileVerticalMove) > 0.01 then
			moveInput += Vector3.yAxis * mobileVerticalMove
		end

		if moveInput.Magnitude > 1 then
			moveInput = moveInput.Unit
		end

		local speed = freecamSpeed
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			speed *= freecamFastMultiplier
		end

		local targetVel = moveInput * speed
		freecamVelocity += (targetVel - freecamVelocity) * math.min(1, CONFIG.FreecamLerpSpeed * dt)
		freecamPos += freecamVelocity * dt

		camera.CFrame = CFrame.lookAt(freecamPos, freecamPos + forward)
		return
	end

	if not root then return end

	if humanoid then
		humanoid.AutoRotate = true

		local state = humanoid:GetState()
		if prevHumanoidState and state ~= prevHumanoidState then
			if state == Enum.HumanoidStateType.Jumping then
				impulseShakeOffset += Vector3.new(0, -jumpImpulseShake, 0)
			elseif prevHumanoidState == Enum.HumanoidStateType.Freefall and state == Enum.HumanoidStateType.Landed then
				impulseShakeOffset += Vector3.new(0, -landImpulseShake, 0)
			end
		end
		prevHumanoidState = state

		local horizVel = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
		local speed = horizVel.Magnitude
		if speed > 0.5 and humanoid.FloorMaterial ~= Enum.Material.Air then
			local isRunning = speed > 18
			local freq = isRunning and CONFIG.RunBobFreq or CONFIG.WalkBobFreq
			local amp = isRunning and runShakeAmp or walkShakeAmp
			bobTimer += dt * freq
			local bobX = math.cos(bobTimer * 0.5) * amp * 0.65
			local bobY = math.abs(math.sin(bobTimer)) * amp
			impulseShakeOffset += (right * bobX) + Vector3.new(0, bobY, 0) * 0.25
		else
			bobTimer = 0
		end
	end

	impulseShakeOffset = impulseShakeOffset:Lerp(Vector3.zero, math.min(1, CONFIG.ShakeDecaySpeed * dt))

	local pivot = root.Position + Vector3.new(0, pivotHeightOffset, 0)
	local shoulderAnchor = pivot + (right * shoulderX) + Vector3.new(0, shoulderY, 0)
	local desiredCamPos = shoulderAnchor - (forward * currentDistance)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local filterList = {}
	if player.Character then
		table.insert(filterList, player.Character)
	end
	for _, inst in ipairs(guiInstances) do
		table.insert(filterList, inst)
	end
	rayParams.FilterDescendantsInstances = filterList

	local camOffsetFromAnchor = desiredCamPos - shoulderAnchor
	if camOffsetFromAnchor.Magnitude > 0.05 then
		local hit = workspace:Raycast(shoulderAnchor, camOffsetFromAnchor, rayParams)
		if hit then
			desiredCamPos = hit.Position + (hit.Normal * 0.35)
		end
	end

	currentCamPos = currentCamPos:Lerp(desiredCamPos, math.min(1, cameraLerpSpeed * dt))

	local aimTarget = shoulderAnchor + (forward * lookAheadDistance)
	local finalPos = currentCamPos + impulseShakeOffset
	camera.CFrame = CFrame.lookAt(finalPos, aimTarget)
end

local function stopScript()
	if destroyed then return end
	destroyed = true

	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
	end)

	for _, conn in ipairs(connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(connections)

	for _, inst in ipairs(guiInstances) do
		pcall(function()
			inst:Destroy()
		end)
	end
	table.clear(guiInstances)

	local hum = getHumanoid()
	if hum then
		hum.AutoRotate = true
		hum.WalkSpeed = 16
		hum.JumpPower = 50
		camera.CameraSubject = hum
	end
	camera.CameraType = Enum.CameraType.Custom
	if not UserInputService.TouchEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

rootEnv[REGISTRY_KEY] = {
	stop = stopScript,
}

createGui()

local humInit = getHumanoid()
if humInit then
	prevHumanoidState = humInit:GetState()
end
if cameraEnabled then
	camera.CameraType = Enum.CameraType.Scriptable
	currentCamPos = camera.CFrame.Position
	if not UserInputService.TouchEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
end

-- Input Handling
local activeTouches: { [InputObject]: Vector2 } = {}

trackConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if destroyed then return end

	if input.KeyCode == CONFIG.FreecamKey and not gameProcessed then
		if not cameraEnabled then
			setCameraEnabled(true)
		end
		setFreecam(not isFreecam)
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if isPointInsideGui(pos) then
			return
		end
		activeTouches[input] = pos
	end
end))

trackConn(UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if destroyed or not cameraEnabled then return end

	if isDraggingGui and panelFrame then
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local cur = Vector2.new(input.Position.X, input.Position.Y)
			local delta = cur - dragStartMousePos
			panelFrame.Position = UDim2.new(
				dragStartPanelPos.X.Scale,
				dragStartPanelPos.X.Offset + delta.X,
				dragStartPanelPos.Y.Scale,
				dragStartPanelPos.Y.Offset + delta.Y
			)
			return
		end
	end

	if activeSliderId then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if not UserInputService.TouchEnabled then
			yaw -= input.Delta.X * mouseSensitivity
			pitch = math.clamp(pitch - input.Delta.Y * mouseSensitivity, CONFIG.MinPitch, CONFIG.MaxPitch)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		if not gameProcessed then
			targetDistance = math.clamp(targetDistance - input.Position.Z * CONFIG.ZoomStep, CONFIG.MinDistance, CONFIG.MaxDistance)
		end
	elseif input.UserInputType == Enum.UserInputType.Touch then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if activeTouches[input] then
			local prevPos = activeTouches[input]
			activeTouches[input] = pos

			local viewportX = camera.ViewportSize.X
			if prevPos.X >= viewportX * CONFIG.OrbitMinScreenXRatio then
				local delta = pos - prevPos
				yaw -= delta.X * touchSensitivity
				pitch = math.clamp(pitch - delta.Y * touchSensitivity, CONFIG.MinPitch, CONFIG.MaxPitch)
			end
		end
	end
end))

trackConn(UserInputService.InputEnded:Connect(function(input)
	if destroyed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingGui = false
	end
	if input.UserInputType == Enum.UserInputType.Touch then
		activeTouches[input] = nil
	end
end))

trackConn(player.CharacterAdded:Connect(function(char)
	if destroyed then return end
	task.wait(0.1)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and cameraEnabled and not isFreecam then
		hum.AutoRotate = true
		prevHumanoidState = hum:GetState()
	end
end))

RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, updateCamera)
