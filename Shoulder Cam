	row.Name = id .. "Row"
	row.Size = fixedPos and UDim2.new(1, -24, 0, 38) or UDim2.new(1, -6, 0, 38)
	if fixedPos then
		row.Position = fixedPos
	end
	row.BackgroundTransparency = 1
	row.Parent = parent

	local header = Instance.new("TextLabel")
	header.Name = "Label"
	header.Size = UDim2.new(1, -64, 0, 16)
	header.Position = UDim2.fromOffset(0, 0)
	header.BackgroundTransparency = 1
	header.Text = labelText
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.TextColor3 = Color3.fromRGB(195, 200, 210)
	header.Font = Enum.Font.GothamSemibold
	header.TextSize = 11
	header.Parent = row

	local valLabel = Instance.new("TextLabel")
	valLabel.Name = "Value"
	valLabel.Size = UDim2.fromOffset(60, 16)
	valLabel.Position = UDim2.new(1, -60, 0, 0)
	valLabel.BackgroundTransparency = 1
	valLabel.Text = string.format(formatStr, getter())
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
	valLabel.Font = Enum.Font.GothamBold
	valLabel.TextSize = 11
	valLabel.Parent = row

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.new(1, 0, 0, 14)
	track.Position = UDim2.fromOffset(0, 20)
	track.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
	track.BorderSizePixel = 0
	track.Active = true
	track.Parent = row

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = Color3.fromRGB(65, 145, 225)
	fill.BorderSizePixel = 0
	fill.Parent = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.fromOffset(16, 16)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(0.5, 0, 0.5, 0)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = track

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local function syncVisuals()
		local span = math.max(1e-6, maxVal - minVal)
		local v = getter()
		local alpha = math.clamp((v - minVal) / span, 0, 1)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valLabel.Text = string.format(formatStr, v)
	end

	local function applyFromScreenX(screenX: number)
		local absPos = track.AbsolutePosition.X
		local absSize = math.max(1, track.AbsoluteSize.X)
		local alpha = math.clamp((screenX - absPos) / absSize, 0, 1)
		setter(minVal + alpha * (maxVal - minVal))
		refreshAllSliders()
	end

	syncVisuals()
	table.insert(sliderUpdaters, syncVisuals)

	trackConn(track.InputBegan:Connect(function(input)
		if destroyed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSliderId = id
			applyFromScreenX(input.Position.X)
		end
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if destroyed or activeSliderId ~= id then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			applyFromScreenX(input.Position.X)
		end
	end))

	trackConn(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if activeSliderId == id then
				activeSliderId = nil
			end
		end
	end))
end

