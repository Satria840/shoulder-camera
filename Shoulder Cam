local function getRootPart(): BasePart?
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(): Humanoid?
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChildOfClass("Humanoid")
end

local function isPointInsideGui(pos: Vector2): boolean
	if panelFrame and panelFrame.Visible then
		local p = panelFrame.AbsolutePosition
		local s = panelFrame.AbsoluteSize
		if pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y then
			return true
		end
	end
	if reopenBtn and reopenBtn.Visible then
		local p = reopenBtn.AbsolutePosition
		local s = reopenBtn.AbsoluteSize
		if pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y then
			return true
		end
	end
	return false
end

