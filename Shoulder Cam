local function setFreecam(enabled: boolean)
	if destroyed then return end
	if enabled and not cameraEnabled then return end

	isFreecam = enabled
	local humanoid = getHumanoid()

	if isFreecam then
		freecamPos = camera.CFrame.Position
		freecamVelocity = Vector3.zero
		if humanoid then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
		end
		if freecamBtn then
			freecamBtn.Text = "Freecam: ON"
			freecamBtn.BackgroundColor3 = Color3.fromRGB(45, 130, 90)
		end
		if mobileControlsFrame and UserInputService.TouchEnabled then
			mobileControlsFrame.Visible = true
		end
	else
		mobileMoveVec = Vector2.zero
		mobileVerticalMove = 0
		if humanoid and cameraEnabled then
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
			humanoid.AutoRotate = true
		end
		local root = getRootPart()
		if root and cameraEnabled then
			currentCamPos = root.Position + Vector3.new(0, shoulderY, targetDistance)
		end
		if freecamBtn then
			freecamBtn.Text = "Freecam: OFF"
			freecamBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
		end
		if mobileControlsFrame then
			mobileControlsFrame.Visible = false
		end
	end
end

local function setCameraEnabled(enabled: boolean)
	if destroyed then return end
	cameraEnabled = enabled

	if not cameraEnabled then
		if isFreecam then
			setFreecam(false)
		end
		local hum = getHumanoid()
		if hum then
			hum.AutoRotate = true
			hum.WalkSpeed = 16
			hum.JumpPower = 50
			camera.CameraSubject = hum
		end
		camera.CameraType = Enum.CameraType.Custom
		if not UserInputService.TouchEnabled then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if camToggleBtn then
			camToggleBtn.Text = "Camera: OFF"
			camToggleBtn.BackgroundColor3 = Color3.fromRGB(130, 45, 55)
		end
	else
		local hum = getHumanoid()
		if hum then
			hum.AutoRotate = true
			hum.WalkSpeed = 16
			hum.JumpPower = 50
			prevHumanoidState = hum:GetState()
		end
		currentCamPos = camera.CFrame.Position
		camera.CameraType = Enum.CameraType.Scriptable
		if not UserInputService.TouchEnabled then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		if camToggleBtn then
			camToggleBtn.Text = "Camera: ON"
			camToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 110, 160)
		end
	end
end

local function createConfigSlider(
	parent: Instance,
	id: string,
	labelText: string,
	minVal: number,
	maxVal: number,
	formatStr: string,
	getter: () -> number,
	setter: (number) -> (),
	fixedPos: UDim2?
)
